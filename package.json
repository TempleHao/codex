{
  "name": "life-workbench",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:preview": "node scripts/build-preview.mjs",
    "serve:preview": "node scripts/serve-preview.mjs",
    "sync:weread": "node scripts/run-weread-sync.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "release:check": "node scripts/release.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  }
}
